FROM maven:3.8.4-openjdk-17 AS build

# Imposta la directory di lavoro
WORKDIR /app

# Copia i file di build
COPY pom.xml .
COPY src ./src

# Compila l'applicazione
RUN mvn clean package -DskipTests

# Usa Tomcat con Java 17 come immagine finale
FROM tomcat:10-jdk17-openjdk

# Rimuove le applicazioni di default di Tomcat
RUN rm -rf /usr/local/tomcat/webapps/*

# Copia il file WAR compilato nella cartella webapps di Tomcat
COPY --from=build /app/target/*.war /usr/local/tomcat/webapps/webmarket.war

# Crea cartella per configurazione personalizzata
RUN mkdir -p /usr/local/tomcat/conf/Catalina/localhost

# Espone la porta 8080
EXPOSE 8080

# Comando per avviare Tomcat
CMD ["catalina.sh", "run"]